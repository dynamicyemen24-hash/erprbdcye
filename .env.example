# ═══════════════════════════════════════════════════════════════════
# NexoraOS™ Environment Variables
# ═══════════════════════════════════════════════════════════════════

# DATABASE_URL: PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT_SECRET: Secret key for JWT token signing (required, min 32 chars)
JWT_SECRET=your-super-secret-key-at-least-32-characters-long

# GEMINI_API_KEY: Google Gemini AI API key (optional, mock used if absent)
GEMINI_API_KEY=

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins (optional)
# Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# NODE_ENV: Set to 'production' for production deployment
NODE_ENV=development

# PORT: Server port (default: 3000)
PORT=3000

# GOOGLE_MAPS_PLATFORM_KEY: Google Maps JavaScript API key (optional, Leaflet used if absent)
GOOGLE_MAPS_PLATFORM_KEY=

# VITE_API_URL: Backend API URL for split deployment (optional)
# Only needed when frontend and backend are on different domains
# Example: https://api.erprbdcye.org
VITE_API_URL=
