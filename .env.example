# ═══════════════════════════════════════════════════════════════════
# NexoraOS™ — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or .env.production to version control.
#
# Generate secure secrets:
#   openssl rand -base64 64
# ═══════════════════════════════════════════════════════════════════

# ─── Database (Neon PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Connection pool tuning (Neon free/launch tiers have tight limits)
# DB_POOL_MIN=0
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=15000
# DB_CONNECT_TIMEOUT_MS=30000
# Enforce strict TLS certificate verification in production
DB_SSL_STRICT=true

# ─── Redis (required in production — cache, rate limits, idempotency) ─
REDIS_ENABLED=true
REDIS_URL=redis://:password@host:6379/0
# Alternative split vars (ignored when REDIS_URL is set):
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ─── JWT Authentication ─────────────────────────────────────────
# Must be at least 32 characters; use `openssl rand -base64 64`
JWT_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret

# ─── Server ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# ─── CORS ───────────────────────────────────────────────────────
# Comma-separated allowed origins (use * for development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Legacy alias — same as CORS_ORIGINS (kept for backward compatibility)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AI / Gemini ────────────────────────────────────────────────
# Optional: Set to enable AI features (projections, receipt parsing)
GEMINI_API_KEY=
AI_ENABLED=false

# ─── Feature Flags ──────────────────────────────────────────────
GEOSPATIAL_ENABLED=true
SMS_ENABLED=false
EMAIL_ENABLED=false

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5

# ─── Backup ─────────────────────────────────────────────────────
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30

# ─── Webhooks ───────────────────────────────────────────────────
WEBHOOKS_ENABLED=false
WEBHOOK_MAX_RETRIES=3
# HMAC secret for inbound webhook verification (required in production when webhooks enabled)
WEBHOOK_SECRET=

# ─── Background worker ──────────────────────────────────────────
# Run embedded durable-queue consumer inside the API process.
# Set WORKER_ONLY=true to run a dedicated worker container (see docker-compose.yml).
WORKER_ENABLED=true

# ─── Observability ──────────────────────────────────────────────
# Optional Sentry DSN — error reporting activates only when set (+ @sentry/node installed)
SENTRY_DSN=
# Optional HTTP log drain (Better Stack / Loki / Datadog). JSON lines POSTed in batches.
LOG_DRAIN_URL=

# ─── Backups ────────────────────────────────────────────────────
# Optional S3 target for nightly pg_dump upload (requires `aws` CLI + IAM env)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=nexoraos/
AWS_REGION=us-east-1

# ─── Security (Advanced) ────────────────────────────────────────
# Auto-derived from JWT_SECRET if not set
AUDIT_HMAC_SECRET=
# Comma-separated IPs to block
IP_BLOCKLIST=

# ─── Rate Limits ────────────────────────────────────────────────
# Override defaults (15-minute window)
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=300
