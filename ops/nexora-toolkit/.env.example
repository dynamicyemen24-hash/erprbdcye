# NexoraOps - example environment variables
# Copy this file to .env and fill in the real values. Never commit .env.
# cp .env.example .env

# Cloud database connection (Neon) - rotate immediately if leaked
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Local database schema path (optional)
# Default: D:/projects26/NexoraOS/src/server/database/initial_schema.ts
LOCAL_SCHEMA_PATH=D:/projects26/NexoraOS/src/server/database/initial_schema.ts
COMPLETION_SCHEMA_PATH=D:/projects26/NexoraOS/src/server/database/enterprise_schema_completion.ts

# Live production site health probe (optional)
LIVE_BASE_URL=https://erprbdcye.org
