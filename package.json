{
  "name": "nexoraos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "install": "npm install",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run migration:validate && npm run security:check",
    "migration:list": "node -e \"const fs=require('fs');const path=require('path');const dir=path.join(process.cwd(),'migrations');if(!fs.existsSync(dir)){console.log('No migrations directory');process.exit(0)}const files=fs.readdirSync(dir).filter(f=>f.endsWith('.sql')).sort();console.log('Pending migrations ('+files.length+'):');files.forEach(f=>{const s=fs.statSync(path.join(dir,f));console.log('- '+f+' ('+s.size+' bytes)')})\"",
    "migration:validate": "npm run migration:list",
    "security:check": "node -e \"try{require('helmet');console.log('Security middleware: OK')}catch(e){console.log('helmet not installed:',e.message)};const fs=require('fs');try{const p=fs.readFileSync('src/server/middleware/policy.middleware.ts','utf8');console.log('Policy middleware loaded:',p.length>0)}catch(e){console.log('Policy file missing:',e.message)}\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.546.0",
    "morgan": "^1.11.0",
    "motion": "^12.23.24",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "signal-exit": "^4.1.0",
    "ua-parser-js": "^2.0.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.1.1"
  }
}
