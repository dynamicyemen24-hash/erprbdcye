# NexoraOps - example environment variables
# Copy this file to .env and fill in the real values. Never commit .env.
# cp .env.example .env

# Cloud database connection (Neon) - rotate immediately if leaked
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Local database schema paths (optional)
# Vendored defaults (offline/CI first): schemas/initial_schema.ts and schemas/enterprise_schema_completion.ts
# Legacy path (last-resort fallback only): D:/projects26/NexoraOS/src/server/database/...
LOCAL_SCHEMA_PATH=schemas/initial_schema.ts
COMPLETION_SCHEMA_PATH=schemas/enterprise_schema_completion.ts

# Live production site health probe (optional)
LIVE_BASE_URL=https://erprbdcye.org
